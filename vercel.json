{
  "buildCommand": "",
  "outputDirectory": "admin",
  "functions": {
    "api/extensionRelease.js": {
      "includeFiles": "admin/version.json"
    }
  },
  "rewrites": [
    { "source": "/api/createLicense", "destination": "/api/licenses" },
    { "source": "/api/getLicense", "destination": "/api/licenses" },
    { "source": "/api/listLicenses", "destination": "/api/licenses" },
    { "source": "/api/updateLicense", "destination": "/api/licenses" },
    { "source": "/api/deleteLicense", "destination": "/api/licenses" },
    { "source": "/api/createPanelUser", "destination": "/api/panelUsers" },
    { "source": "/api/listPanelUsers", "destination": "/api/panelUsers" },
    { "source": "/api/updatePanelUser", "destination": "/api/panelUsers" },
    { "source": "/api/deletePanelUser", "destination": "/api/panelUsers" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, PATCH, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
